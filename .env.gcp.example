# TRINETRA AI — Google Cloud Production (India: asia-south1 Mumbai)
# Copy values to Secret Manager / Cloud Run env. NEVER commit real secrets.

NODE_ENV=production
LOCAL_DEV=false
REQUIRE_LLM_KEY=true
PORT=8080

# Region & org (government deployment metadata)
DEPLOYMENT_REGION=asia-south1
ORG_NAME=National Cyber Forensics Unit

# Cloud SQL MySQL 8 (private IP or Cloud SQL Auth proxy socket)
# Format: mysql://USER:PASSWORD@/trinetra?socketPath=/cloudsql/PROJECT:asia-south1:trinetra-mysql
DATABASE_URL=mysql://trinetra:CHANGE_ME@/trinetra?socketPath=/cloudsql/YOUR_PROJECT:asia-south1:trinetra-mysql

# Session
JWT_SECRET=CHANGE_ME_LONG_RANDOM
VITE_APP_ID=trinetra-gov
OWNER_OPEN_ID=gov-admin-open-id

# APK storage (India region bucket)
GCP_PROJECT_ID=your-gcp-project
GCS_BUCKET=trinetra-apk-artifacts-asia-south1

# Durable investigation jobs (Cloud Tasks)
GCP_LOCATION=asia-south1
GCP_TASKS_QUEUE=trinetra-investigations
WORKER_URL=https://trinetra-ai-xxxxx-as.a.run.app
WORKER_SECRET=CHANGE_ME_WORKER_BEARER_TOKEN

# Multi-instance WebSocket fan-out (Memorystore Redis)
REDIS_URL=redis://10.0.0.5:6379

# AI — Manus Forge / Gemini (required in production)
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=CHANGE_ME

# Optional: Vertex AI (set USE_VERTEX_AI=true when implemented)
# USE_VERTEX_AI=false
# VERTEX_PROJECT_ID=your-gcp-project
# VERTEX_LOCATION=asia-south1

# OAuth (disable dev login in production)
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im
