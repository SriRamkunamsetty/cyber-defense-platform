# =============================================================================
# TRINETRA AI — Local development environment
# Copy to .env and adjust values:  cp .env.example .env
# =============================================================================

# --- Local dev mode (recommended for Cursor / hackathon demos) ---
# Enables filesystem APK storage, /api/dev/login, and optional LLM mock
LOCAL_DEV=true
VITE_LOCAL_DEV=true

PORT=3000
NODE_ENV=development

# --- Database (MySQL 8 required) ---
# Example with Docker:
#   docker run -d --name trinetra-mysql -p 3306:3306 \
#     -e MYSQL_ROOT_PASSWORD=trinetra -e MYSQL_DATABASE=trinetra mysql:8
DATABASE_URL=mysql://root:trinetra@127.0.0.1:3306/trinetra

# --- Session / auth ---
JWT_SECRET=local-dev-jwt-secret-change-in-production
VITE_APP_ID=trinetra-local
OWNER_OPEN_ID=local-dev-user

# Manus OAuth (only needed when LOCAL_DEV=false)
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im

# --- AI (Gemini via Manus Forge) ---
# Required for real AI reasoning. If empty in LOCAL_DEV, a grounded mock is used.
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=

# --- Optional: APK reverse engineering tools (add to PATH) ---
# apktool, jadx — run: npm run tools:check
